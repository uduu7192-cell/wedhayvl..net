        function simulatedDeposit(amount) {
            AudioEngine.playWin();
            currentUser.balance += amount;
            saveUser();
            alert(`Nạp thành công ${amount.toLocaleString('vi-VN')}đ!`);
            closeModal('modal-deposit');
        }

        function handleWithdraw(e) {
            e.preventDefault();
            const amt = parseInt(document.getElementById('withdraw-amount').value);
            if (amt > currentUser.balance) { alert('Số dư không đủ!'); return; }
            currentUser.balance -= amt;
            saveUser();
            closeModal('modal-withdraw');
            alert(`Rút thành công ${amt.toLocaleString('vi-VN')}đ!`);
        }

        function showScreen(screen) {
            AudioEngine.playClick();
            clearAllGameTimers();
            document.getElementById('screen-lobby').classList.add('hidden');
            document.getElementById('screen-game').classList.add('hidden');
            if (screen === 'lobby') {
                document.getElementById('screen-lobby').classList.remove('hidden');
                currentGame = null;
            } else {
                document.getElementById('screen-game').classList.remove('hidden');
