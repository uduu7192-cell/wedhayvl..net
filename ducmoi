        function triggerSlotSpin() {
            const betAmt = parseInt(document.getElementById('slot-bet-input').value);
            if (isNaN(betAmt) || betAmt <= 0) { alert('Vui lòng nhập mức cược hợp lệ!'); return; }
            if (betAmt > currentUser.balance) { alert('Số dư của bạn không đủ để cược!'); return; }

            AudioEngine.playClick();
            currentUser.balance -= betAmt;
            saveUser();

            const spinBtn = document.getElementById('slot-spin-btn');
            spinBtn.disabled = true;
            spinBtn.classList.add('opacity-50');
            document.getElementById('slot-result-text').innerText = 'Đang quay hũ...';

            let s1 = document.getElementById('slot-1');
            let s2 = document.getElementById('slot-2');
            let s3 = document.getElementById('slot-3');

            s1.classList.add('slot-spinning');
            s2.classList.add('slot-spinning');
            s3.classList.add('slot-spinning');

            // Xác định trước kết quả (tỷ lệ thắng có 3 hình hoặc 2 hình)
            const rand = Math.random();
            let finalIdx1 = Math.floor(Math.random() * SLOT_ICONS.length);
            let finalIdx2, finalIdx3;

            if (rand < 0.25) {
                // 3 hình giống nhau
                finalIdx2 = finalIdx1;
                finalIdx3 = finalIdx1;
            } else if (rand < 0.60) {
                // 2 hình giống nhau
                finalIdx2 = finalIdx1;
                do {
                    finalIdx3 = Math.floor(Math.random() * SLOT_ICONS.length);
                } while (finalIdx3 === finalIdx1);
            } else {
                // Không hình nào giống nhau (thua)
                finalIdx2 = (finalIdx1 + 1) % SLOT_ICONS.length;
                do {
                    finalIdx3 = Math.floor(Math.random() * SLOT_ICONS.length);
                } while (finalIdx3 === finalIdx1 || finalIdx3 === finalIdx2);
            }

            // Hiệu ứng quay số liên tục
            const spinInterval = setInterval(() => {
                s1.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
                s2.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
                s3.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
            }, 80);

            // Dừng ô 1 sau 0.8s
