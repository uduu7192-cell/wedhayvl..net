<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ducgemevui - Cổng Game Đổi Thưởng VIP</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: {
                            300: '#fde047',
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                            700: '#a16207'
                        },
                        casino: {
                            dark: '#0f051d',
                            card: '#1a0b2e',
                            accent: '#2a124d',
                            red: '#e11d48'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;700&family=Teko:wght@600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto Condensed', sans-serif;
            background-color: #080311;
            color: #ffffff;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        .font-digits {
            font-family: 'Teko', sans-serif;
        }
        .gold-gradient-text {
            background: linear-gradient(180deg, #fff7ed 0%, #facc15 50%, #ca8a04 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-btn {
            background: linear-gradient(180deg, #facc15 0%, #ca8a04 100%);
            color: #000;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(202, 138, 4, 0.4);
            transition: all 0.2s ease;
        }
        .gold-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(250, 204, 21, 0.6);
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f051d;
        }
        ::-webkit-scrollbar-thumb {
            background: #ca8a04;
            border-radius: 3px;
        }
        .bowl-touch-area {
            cursor: grab;
            touch-action: none;
        }
        .bowl-touch-area:active {
            cursor: grabbing;
        }
        .duck-target {
            position: absolute;
            font-size: 2.5rem;
            color: #facc15;
            cursor: pointer;
            user-select: none;
            transition: left 3s linear;
            z-index: 10;
        }

        /* Dice Face Custom Dot Styles */
        .dice-face {
            background: #ffffff;
            border-radius: 8px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.3), 0 2px 5px rgba(0,0,0,0.5);
            display: grid;
            width: 34px;
            height: 34px;
            padding: 5px;
            position: relative;
        }
        .dot {
            width: 6px;
            height: 6px;
            background-color: #ef4444;
            border-radius: 50%;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);
        }
        .dice-1 { grid-template: 1fr / 1fr; justify-items: center; align-items: center; }
        .dice-1 .dot { background-color: #dc2626; width: 8px; height: 8px; }

        .dice-2 { grid-template: repeat(2, 1fr) / repeat(2, 1fr); justify-items: space-between; align-items: center; }
        .dice-2 .dot:nth-child(2) { justify-self: end; align-self: end; }

        .dice-3 { grid-template: repeat(3, 1fr) / repeat(3, 1fr); justify-items: center; align-items: center; }
        .dice-3 .dot:nth-child(1) { grid-area: 1 / 1; }
        .dice-3 .dot:nth-child(2) { grid-area: 2 / 2; }
        .dice-3 .dot:nth-child(3) { grid-area: 3 / 3; }

        .dice-4 { grid-template: repeat(2, 1fr) / repeat(2, 1fr); justify-items: space-between; align-items: center; }

        .dice-5 { grid-template: repeat(3, 1fr) / repeat(3, 1fr); justify-items: center; align-items: center; }
        .dice-5 .dot:nth-child(1) { grid-area: 1 / 1; }
        .dice-5 .dot:nth-child(2) { grid-area: 1 / 3; }
        .dice-5 .dot:nth-child(3) { grid-area: 2 / 2; }
        .dice-5 .dot:nth-child(4) { grid-area: 3 / 1; }
        .dice-5 .dot:nth-child(5) { grid-area: 3 / 3; }

        .dice-6 { grid-template: repeat(3, 1fr) / repeat(2, 1fr); justify-items: center; align-items: center; }

        @keyframes slotSpinAnim {
            0% { transform: translateY(-10px); opacity: 0.6; }
            50% { transform: translateY(10px); opacity: 0.6; }
            100% { transform: translateY(0); opacity: 1; }
        }
        .slot-spinning {
            animation: slotSpinAnim 0.12s infinite alternate ease-in-out;
        }
        .slot-pop {
            animation: slotPopAnim 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes slotPopAnim {
            0% { transform: scale(0.8); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }
    </style>
</head>
