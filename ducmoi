        // Helper render HTML mặt xúc xắc chuẩn chấm
        function renderDiceFaceHTML(val) {
            let dotsHTML = '';
            for (let i = 0; i < val; i++) {
                dotsHTML += `<div class="dot"></div>`;
            }
            return `<div class="dice-face dice-${val}">${dotsHTML}</div>`;
        }

        // Cơ chế nặn đĩa/bát sâu
        function setupDeepSqueezeDrag(bowlId, stateObj, openCallback) {
            const bowl = document.getElementById(bowlId);
            if (!bowl) return;
            let isDragging = false, startX = 0, startY = 0;

            bowl.onpointerdown = (e) => {
                if (stateObj.phase !== 'SQUEEZING') return;
                isDragging = true;
                startX = e.clientX;
                startY = e.clientY;
                bowl.setPointerCapture(e.pointerId);
            };

            bowl.onpointermove = (e) => {
                if (!isDragging || stateObj.phase !== 'SQUEEZING') return;
                let dx = e.clientX - startX;
                let dy = e.clientY - startY;
                bowl.style.transform = `translate(${dx}px, ${dy}px)`;
            };

            bowl.onpointerup = (e) => {
                if (!isDragging) return;
                isDragging = false;
                if (stateObj.phase === 'SQUEEZING') {
                    openCallback();
                }
            };
        }

