            const title = document.getElementById('current-game-title');

            if (gameKey === 'taixiu') { title.innerText = 'TÀI XỈU VIP'; initTaiXiu(board); }
            else if (gameKey === 'xocdia') { title.innerText = 'XÓC ĐĨA VIP'; initXocDia(board); }
            else if (gameKey === 'baucua') { title.innerText = 'BẦU CUA TÔM CÁ'; initBauCua(board); }
            else if (gameKey === 'slot') { title.innerText = 'QUAY HŨ 3 HÌNH'; initSlot(board); }
