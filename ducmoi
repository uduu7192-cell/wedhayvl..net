                    s2.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
                    s3.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
                }, 80);

                // Dừng ô 2 sau 0.7s nữa
                setTimeout(() => {
                    clearInterval(spinInterval2);
                    s2.classList.remove('slot-spinning');
                    s2.classList.add('slot-pop');
                    s2.innerHTML = `<i class="fa-solid ${SLOT_ICONS[finalIdx2].icon} ${SLOT_ICONS[finalIdx2].color}"></i>`;
                    AudioEngine.playClick();

                    // Tiếp tục quay ô cuối
                    const spinInterval3 = setInterval(() => {
                        s3.innerHTML = `<i class="fa-solid ${SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)].icon}"></i>`;
                    }, 80);

                    // Dừng ô 3 sau 0.7s nữa
                    setTimeout(() => {
                        clearInterval(spinInterval3);
                        s3.classList.remove('slot-spinning');
                        s3.classList.add('slot-pop');
                        s3.innerHTML = `<i class="fa-solid ${SLOT_ICONS[finalIdx3].icon} ${SLOT_ICONS[finalIdx3].color}"></i>`;

                        // Kiểm tra kết quả: Chỉ nhận thưởng khi có ít nhất 2 hình giống nhau
                        let matchCount = 0;
                        if (finalIdx1 === finalIdx2 && finalIdx2 === finalIdx3) {
                            matchCount = 3;
                        } else if (finalIdx1 === finalIdx2 || finalIdx1 === finalIdx3 || finalIdx2 === finalIdx3) {
                            matchCount = 2;
                        }

                        if (matchCount >= 2) {
                            let multiplier = matchCount === 3 ? 10 : 2;
                            const winAmount = Math.floor(betAmt * multiplier);
                            currentUser.balance += winAmount;
                            saveUser();

                            AudioEngine.playWin();
                            document.getElementById('slot-result-text').innerHTML = `🎉 Trúng <span class="text-yellow-400 font-bold">${matchCount} hình giống</span>! Thưởng <span class="text-emerald-400 font-bold">+${winAmount.toLocaleString('vi-VN')}đ</span> (x${multiplier})`;
