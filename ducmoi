            container.innerHTML = `
                <div class="flex flex-col items-center space-y-4 max-w-xl mx-auto">
                    <div class="relative w-full aspect-video bg-gradient-to-b from-sky-950 via-casino-dark to-black rounded-2xl border-2 border-gold-500/40 overflow-hidden shadow-2xl flex flex-col justify-end p-4">
                        <canvas id="crash-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
                        <div id="crash-plane" class="absolute text-4xl text-sky-400 transition-all duration-75 z-10" style="bottom: 10px; left: 10px;">
                            <i id="plane-icon" class="fa-solid fa-plane-up"></i>
                        </div>
                        <div class="relative z-20 flex flex-col items-center mb-2">
                            <div id="crash-mult" class="text-5xl font-black font-digits text-yellow-400 tracking-wider">1.00x</div>
                            <div id="crash-status-text" class="text-xs text-gray-300 mt-1">Sẵn sàng cất cánh!</div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between w-full bg-casino-card p-3 rounded-xl border border-gold-500/30 gap-3">
                        <input type="number" id="crash-bet-input" value="10000000" step="1000000" class="bg-black/60 border border-gold-500/30 rounded-lg px-3 py-2 text-sm text-yellow-300 font-digits w-36 focus:outline-none">
                        <button id="crash-action-btn" onclick="triggerCrashAction()" class="gold-btn flex-grow py-2.5 rounded-xl text-xs font-bold uppercase">BAY (10.000.000đ)</button>
                    </div>
                    <div class="w-full bg-casino-card p-3 rounded-xl border border-gold-500/30">
                        <h4 class="text-xs font-bold text-yellow-400 mb-2">LỊCH SỬ CRASH</h4>
                        <div class="flex items-center space-x-1.5 overflow-x-auto py-1" id="crash-history-dots"></div>
                    </div>
                </div>
            `;
            renderHistory('crash-history-dots', crashHistory);
            setupCrashCanvas();
        }

        function setupCrashCanvas(progress = 0) {
            const canvas = document.getElementById('crash-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (progress <= 0) return;

            ctx.beginPath();
            ctx.moveTo(0, canvas.height - 20);
            let curX = progress * (canvas.width - 60);
            let curY = (canvas.height - 40) - (progress * (canvas.height - 80));
            ctx.quadraticCurveTo(curX * 0.5, canvas.height - 20, curX + 30, curY + 20);
            ctx.strokeStyle = '#38bdf8'; ctx.lineWidth = 4; ctx.stroke();
            ctx.lineTo(curX + 30, canvas.height); ctx.lineTo(0, canvas.height);
            ctx.fillStyle = 'rgba(56, 189, 248, 0.15)'; ctx.fill();

            const plane = document.getElementById('crash-plane');
            if (plane) {
                plane.style.left = Math.min(curX + 15, canvas.width - 50) + 'px';
                plane.style.bottom = Math.min(Math.max(progress * (canvas.height - 70), 10), canvas.height - 60) + 'px';
            }
        }

        function triggerCrashAction() {
            const planeEl = document.getElementById('plane-icon');
            if (crashRunning) {
                AudioEngine.playWin();
                crashRunning = false;
                const winAmount = Math.floor(crashBet * crashMultiplier);
                currentUser.balance += winAmount;
                saveUser();
                document.getElementById('crash-status-text').innerText = `Rút thành công: +${winAmount.toLocaleString('vi-VN')}đ`;
                document.getElementById('crash-action-btn').innerText = 'BAY TIẾP';
                if (planeEl) planeEl.className = "fa-solid fa-plane-circle-check text-emerald-400";
            } else {
                const amt = parseInt(document.getElementById('crash-bet-input').value);
                if (amt > currentUser.balance) return alert('Số dư không đủ!');
                AudioEngine.playClick();
                currentUser.balance -= amt;
                saveUser();
                crashBet = amt; crashMultiplier = 1.00; crashRunning = true;
                document.getElementById('crash-action-btn').innerText = 'RÚT THƯỞNG NGAY';
                document.getElementById('crash-status-text').innerText = 'Máy bay đang bay lên...';
                if (planeEl) planeEl.className = "fa-solid fa-plane-up text-sky-400";

                const crashPoint = (1.2 + Math.random() * 4.3).toFixed(2);
                let steps = 0;
                const loop = setInterval(() => {
                    if (!crashRunning || currentGame !== 'crash') { clearInterval(loop); return; }
                    steps++;
                    crashMultiplier += 0.015;
                    document.getElementById('crash-mult').innerText = crashMultiplier.toFixed(2) + 'x';
                    setupCrashCanvas(Math.min(steps / 120, 0.9));

                    if (crashMultiplier >= crashPoint) {
                        clearInterval(loop);
                        crashRunning = false;
                        AudioEngine.playShake();
                        document.getElementById('crash-mult').innerText = 'CRASHED!';
                        document.getElementById('crash-status-text').innerText = `Nổ ở mốc ${crashPoint}x!`;
                        document.getElementById('crash-action-btn').innerText = 'CƯỢC PHIÊN MỚI';
                        if (planeEl) planeEl.className = "fa-solid fa-fire text-rose-500 animate-bounce";
                        crashHistory.push({ label: crashPoint + 'x', type: parseFloat(crashPoint) >= 2.0 ? 'TAI' : 'XIU' });
                        renderHistory('crash-history-dots', crashHistory);
                    }
                }, 100);
            }
        }

        // ================= 6. RẮN SĂN MỒI =================
        let snakeHistory = [];
        function initSnake(container) {
            container.innerHTML = `
                <div class="flex flex-col items-center space-y-3 max-w-xl mx-auto w-full">
                    <div class="text-xs text-yellow-300 font-bold">Ăn mồi nhận +5,000đ</div>
                    <canvas id="snake-canvas" width="300" height="300" class="bg-black border-2 border-gold-500/40 rounded-xl shadow-xl"></canvas>
                    <div class="grid grid-cols-3 gap-2 w-48">
                        <div></div><button onclick="moveSnake('UP')" class="bg-purple-800 p-2 rounded text-xs font-bold">⬆️</button><div></div>
                        <button onclick="moveSnake('LEFT')" class="bg-purple-800 p-2 rounded text-xs font-bold">⬅️</button>
                        <button onclick="moveSnake('DOWN')" class="bg-purple-800 p-2 rounded text-xs font-bold">⬇️</button>
                        <button onclick="moveSnake('RIGHT')" class="bg-purple-800 p-2 rounded text-xs font-bold">➡️</button>
                    </div>
                </div>
            `;
            startSnakeGame();
        }
        let snakeDir = 'RIGHT';
        function moveSnake(dir) {
            if (dir === 'UP' && snakeDir !== 'DOWN') snakeDir = 'UP';
            if (dir === 'DOWN' && snakeDir !== 'UP') snakeDir = 'DOWN';
            if (dir === 'LEFT' && snakeDir !== 'RIGHT') snakeDir = 'LEFT';
            if (dir === 'RIGHT' && snakeDir !== 'LEFT') snakeDir = 'RIGHT';
        }
        function startSnakeGame() {
            const canvas = document.getElementById('snake-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            snakeDir = 'RIGHT';
            let snake = [{x: 5, y: 5}, {x: 4, y: 5}, {x: 3, y: 5}];
            let food = {x: 10, y: 10};
            let score = 0;

            const loop = setInterval(() => {
                if (currentGame !== 'snake') { clearInterval(loop); return; }
                let head = {x: snake[0].x, y: snake[0].y};
                if (snakeDir === 'UP') head.y--;
                if (snakeDir === 'DOWN') head.y++;
                if (snakeDir === 'LEFT') head.x--;
                if (snakeDir === 'RIGHT') head.x++;

                if (head.x < 0 || head.x >= 15 || head.y < 0 || head.y >= 15 || snake.some(s => s.x === head.x && s.y === head.y)) {
                    clearInterval(loop);
                    alert(`Game Over! Điểm số: ${score}`);
                    return;
                }
                snake.unshift(head);
                if (head.x === food.x && head.y === food.y) {
                    AudioEngine.playWin();
                    score += 5000;
                    currentUser.balance += 5000;
                    saveUser();
                    food = {x: Math.floor(Math.random()*15), y: Math.floor(Math.random()*15)};
                } else { snake.pop(); }

                ctx.fillStyle = '#080311'; ctx.fillRect(0, 0, 300, 300);
                ctx.fillStyle = '#ef4444'; ctx.fillRect(food.x*20, food.y*20, 18, 18);
                snake.forEach((s, i) => { ctx.fillStyle = i === 0 ? '#facc15' : '#ca8a04'; ctx.fillRect(s.x*20, s.y*20, 18, 18); });
            }, 180);
        }

        // ================= 7. BẮN VỊT =================
        let duckHistory = [];
        function initDuck(container) {
            container.innerHTML = `
                <div class="flex flex-col items-center space-y-3 max-w-xl mx-auto w-full">
                    <div class="text-xs text-yellow-300 font-bold">Bắn trúng vịt nhận ngay 10,000đ (Cược 2,000đ/phát)</div>
                    <div id="duck-field" class="relative w-full h-[300px] bg-gradient-to-b from-sky-800 to-emerald-950 rounded-2xl border-2 border-gold-500/40 overflow-hidden cursor-crosshair"></div>
                </div>
            `;
            startDuckGame();
        }
        function startDuckGame() {
            const field = document.getElementById('duck-field');
            if (!field) return;
            field.onclick = () => {
                if (currentUser.balance >= 2000) { currentUser.balance -= 2000; saveUser(); AudioEngine.playClick(); }
            };
            const loop = setInterval(() => {
                if (currentGame !== 'duck') { clearInterval(loop); return; }
                const f = document.getElementById('duck-field');
                if (!f) return;
                const duck = document.createElement('div');
                duck.className = 'duck-target';
                duck.innerHTML = '<i class="fa-solid fa-feather-pointed text-yellow-400"></i>';
                duck.style.top = (Math.random() * 200 + 20) + 'px';
                duck.style.left = '-60px';
                duck.onclick = (e) => {
                    e.stopPropagation();
                    AudioEngine.playWin();
                    currentUser.balance += 10000;
                    saveUser();
                    duck.innerHTML = '<span class="text-red-500 text-xs font-bold">+10k</span>';
                    setTimeout(() => duck.remove(), 300);
                };
                f.appendChild(duck);
                setTimeout(() => { duck.style.left = (f.clientWidth + 60) + 'px'; }, 50);
                setTimeout(() => { if (duck.parentNode) duck.remove(); }, 3100);
            }, 1400);
        }

        function renderHistory(elementId, historyArray) {
            const container = document.getElementById(elementId);
            if (!container) return;
            if (historyArray.length === 0) {
                for (let i = 0; i < 8; i++) historyArray.push({ label: 'VIP', type: Math.random() > 0.5 ? 'TAI' : 'XIU' });
            }
            container.innerHTML = historyArray.slice(-14).map(h => `
                <div class="w-7 h-7 rounded-full flex flex-col items-center justify-center font-bold text-[10px] shadow border ${h.type === 'TAI' ? 'bg-red-600 text-white border-red-400' : 'bg-blue-600 text-white border-blue-400'}">
                    ${h.label}
                </div>
            `).join('');
        }

        window.onload = () => { initAuth(); showScreen('lobby'); };
    </script>
</body>
</html>
