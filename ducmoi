                bowl.classList.remove('hidden'); 
            }
            if (bowlText) bowlText.innerText = "Đang Đặt Cược";
            renderHistory('tx-history-dots', txState.history);

            txTimer = setInterval(() => {
                if (currentGame !== 'taixiu') { clearInterval(txTimer); return; }
                if (txState.phase === 'BETTING') {
