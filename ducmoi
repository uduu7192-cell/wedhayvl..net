        function placeBetSingleSide(side, oppositeSide, stateObj) {
            if (stateObj.phase !== 'BETTING') { alert('Đã hết thời gian đặt cược!'); return; }
            if (stateObj.bets[oppositeSide] > 0) { alert('Chỉ được phép cược 1 bên!'); return; }
            if (currentUser.balance < selectedChip) { alert('Số dư không đủ!'); return; }
            AudioEngine.playClick();
            currentUser.balance -= selectedChip;
            saveUser();
            stateObj.bets[side] = (stateObj.bets[side] || 0) + selectedChip;
            const el = document.getElementById(`bet-${side}`);
            if (el) el.innerText = stateObj.bets[side].toLocaleString('vi-VN');
        }

        function placeBet(option, stateObj) {
            if (stateObj.phase !== 'BETTING') { alert('Đã hết thời gian đặt cược!'); return; }
            if (currentUser.balance < selectedChip) { alert('Số dư không đủ!'); return; }
            AudioEngine.playClick();
            currentUser.balance -= selectedChip;
            saveUser();
            stateObj.bets[option] = (stateObj.bets[option] || 0) + selectedChip;
            const el = document.getElementById(`bet-${option}`);
            if (el) el.innerText = stateObj.bets[option].toLocaleString('vi-VN');
        }

