            document.getElementById('btn-open-tx').classList.add('hidden');
            const bowl = document.getElementById('tx-bowl');
            if (bowl) bowl.classList.add('hidden');

            const total = txState.results.reduce((a, b) => a + b, 0);
            const winChoice = total >= 11 ? 'TAI' : 'XIU';
            const betAmt = txState.bets[winChoice] || 0;
            if (betAmt > 0 && currentUser) {
                const winAmount = Math.floor(betAmt * 1.95);
