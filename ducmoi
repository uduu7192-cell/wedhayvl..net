        }

        function handleAuth(e) {
            e.preventDefault();
            const uname = document.getElementById('auth-username').value.trim();
            const pass = document.getElementById('auth-password').value.trim();
            if (!uname) return;

            let accounts = JSON.parse(localStorage.getItem('ducgemevui_accounts') || '[]');
            let foundUser = accounts.find(acc => acc.username === uname);

            if (isAuthRegisterMode) {
                if (foundUser) { alert('Tên tài khoản này đã tồn tại!'); return; }
                currentUser = { username: uname, password: pass, balance: 10000000 };
                saveUser();
                closeModal('modal-auth');
                alert('Đăng ký tài khoản thành công! Tặng ngay 10.000.000đ.');
            } else {
                if (!foundUser) {
                    alert('Tài khoản không tồn tại! Vui lòng bấm Đăng ký tài khoản mới.');
                    return;
                }
                if (foundUser.password && foundUser.password !== pass) {
                    alert('Mật khẩu không chính xác!');
                    return;
                }
                currentUser = foundUser;
                saveUser();
                closeModal('modal-auth');
                alert('Đăng nhập thành công!');
            }
