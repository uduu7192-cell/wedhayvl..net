                clearInterval(spinInterval);
                s1.classList.remove('slot-spinning');
                s1.classList.add('slot-pop');
                s1.innerHTML = `<i class="fa-solid ${SLOT_ICONS[finalIdx1].icon} ${SLOT_ICONS[finalIdx1].color}"></i>`;
