        function saveUser() {
            if (currentUser) {
                localStorage.setItem('ducgemevui_current_user', JSON.stringify(currentUser));
                let accounts = JSON.parse(localStorage.getItem('ducgemevui_accounts') || '[]');
                const index = accounts.findIndex(acc => acc.username === currentUser.username);
                if (index !== -1) accounts[index] = currentUser;
